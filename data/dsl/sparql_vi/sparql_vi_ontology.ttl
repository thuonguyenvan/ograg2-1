@prefix : <http://ograg.org/sparql-vi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================
# SPARQL-VI Ontology
# Vietnamese SPARQL DSL for OG-RAG Testing
# ============================================

<http://ograg.org/sparql-vi> a owl:Ontology ;
    rdfs:label "SPARQL-VI Ontology"@en ;
    rdfs:label "Ontology SPARQL-VI"@vi ;
    rdfs:comment "Formal specification of SPARQL-VI (Vietnamese SPARQL) DSL"@en ;
    owl:versionInfo "1.0" .

# ============================================
# Query Types (Loại Truy Vấn)
# ============================================

:TruyVan a owl:Class ;
    rdfs:label "Truy vấn"@vi ;
    rdfs:label "Query"@en ;
    rdfs:comment "Base class for all SPARQL-VI queries"@en .

:TruyVanCHONJ_KW a owl:Class ;
    rdfs:subClassOf :TruyVan ;
    rdfs:label "Truy vấn CHONJ_KW (SELECT)"@vi ;
    rdfs:comment "CHONJ_KW query returns variable bindings. Equivalent to SPARQL SELECT."@en ;
    :keywords "CHONJ_KW, SELECT" ;
    :syntax "CHONJ_KW ?variable NOII_MA_KK { pattern }" ;
    :example "CHONJ_KW ?ten NOII_MA_KK { ?nguoi :coTen ?ten }" .

:TruyVanXAY_DUNGWJ a owl:Class ;
    rdfs:subClassOf :TruyVan ;
    rdfs:label "Truy vấn XAY_DUNGWJ (CONSTRUCT)"@vi ;
    rdfs:comment "XAY_DUNGWJ query returns RDF graph. Equivalent to SPARQL CONSTRUCT."@en ;
    :keywords "XAY_DUNGWJ, CONSTRUCT" ;
    :syntax "XAY_DUNGWJ { template } NOII_MA_KK { pattern }" ;
    :example "XAY_DUNGWJ { ?x :duocGoi ?ten } NOII_MA_KK { ?x :coTen ?ten }" .

:TruyVanHOIQQ_YZ a owl:Class ;
    rdfs:subClassOf :TruyVan ;
    rdfs:label "Truy vấn HOIQQ_YZ (ASK)"@vi ;
    rdfs:comment "HOIQQ_YZ query returns boolean. Equivalent to SPARQL ASK."@en ;
    :keywords "HOIQQ_YZ, ASK" ;
    :syntax "HOIQQ_YZ NOII_MA_KK { pattern }" ;
    :example "HOIQQ_YZ NOII_MA_KK { ?nguoi :coTuoi ?tuoi . LOCJ_RR(?tuoi > 18) }" .

:TruyVanMO_TAR_PP a owl:Class ;
    rdfs:subClassOf :TruyVan ;
    rdfs:label "Truy vấn MO_TAR_PP (DESCRIBE)"@vi ;
    rdfs:comment "MO_TAR_PP query returns RDF description. Equivalent to SPARQL DESCRIBE."@en ;
    :keywords "MO_TAR_PP, DESCRIBE" ;
    :syntax "MO_TAR_PP ?resource NOII_MA_KK { pattern }" .

# ============================================
# Clauses (Mệnh Đề)
# ============================================

:MenhDe a owl:Class ;
    rdfs:label "Mệnh đề"@vi ;
    rdfs:comment "Base class for all clauses"@en .

:MenhDeNOII_MA_KK a owl:Class ;
    rdfs:subClassOf :MenhDe ;
    rdfs:label "Mệnh đề NOII_MA_KK (WHERE)"@vi ;
    rdfs:comment "NOII_MA_KK clause contains graph patterns. Required for most queries."@en ;
    :keywords "NOII_MA_KK, WHERE" ;
    :constraint "Required for CHONJ_KW, HOIQQ_YZ queries" ;
    :syntax "NOII_MA_KK { triple_pattern }" .

:MenhDeLOCJ_RR a owl:Class ;
    rdfs:subClassOf :MenhDe ;
    rdfs:label "Mệnh đề LOCJ_RR (FILTER)"@vi ;
    rdfs:comment "LOCJ_RR filters solutions by condition. Equivalent to SPARQL FILTER."@en ;
    :keywords "LOCJ_RR, FILTER" ;
    :syntax "LOCJ_RR(condition)" ;
    :example "LOCJ_RR(?tuoi > 18)" ;
    :constraint "Must be used inside NOII_MA_KK clause" .

:MenhDeNHOMM_THEO_YY a owl:Class ;
    rdfs:subClassOf :MenhDe ;
    rdfs:label "Mệnh đề NHOMM_THEO_YY (GROUP BY)"@vi ;
    rdfs:comment "NHOMM_THEO_YY groups results. Used with aggregate functions."@en ;
    :keywords "NHOMM_THEO_YY, GROUP BY" ;
    :syntax "NHOMM_THEO_YY ?variable" ;
    :constraint "Required when using aggregate functions DEMM_JJ, TONGG_WW, TRUNGG_BINH_PP" .

:MenhDeCOO_ZZ a owl:Class ;
    rdfs:subClassOf :MenhDe ;
    rdfs:label "Mệnh đề COO_ZZ (HAVING)"@vi ;
    rdfs:comment "COO_ZZ filters grouped results. Equivalent to SPARQL HAVING."@en ;
    :keywords "COO_ZZ, HAVING" ;
    :syntax "COO_ZZ (condition)" ;
    :constraint "Can only be used with NHOMM_THEO_YY" .

:MenhDeTU_XZYJ_CHON_PP a owl:Class ;
    rdfs:subClassOf :MenhDe ;
    rdfs:label "Mệnh đề TUYJ_CHON_PP (OPTIONAL)"@vi ;
    rdfs:comment "TUYJ_CHON_PP makes pattern matching optional."@en ;
    :keywords "TUYJ_CHON_PP, OPTIONAL" ;
    :syntax "TUYJ_CHON_PP { pattern }" .

# ============================================
# Aggregate Functions (Hàm Tổng Hợp)
# ============================================

:HamTongHop a owl:Class ;
    rdfs:label "Hàm tổng hợp"@vi ;
    rdfs:comment "Aggregate functions for NHOMM_THEO_YY queries"@en .

:HamDEMM_JJ a owl:Class ;
    rdfs:subClassOf :HamTongHop ;
    rdfs:label "DEMM_JJ (COUNT)"@vi ;
    rdfs:comment "Counts number of values"@en ;
    :keywords "DEMM_JJ, COUNT" ;
    :syntax "DEMM_JJ(?variable)" ;
    :constraint "Requires NHOMM_THEO_YY clause" .

:HamTONGG_WW a owl:Class ;
    rdfs:subClassOf :HamTongHop ;
    rdfs:label "TONGG_WW (SUM)"@vi ;
    rdfs:comment "Sums numeric values"@en ;
    :keywords "TONGG_WW, SUM" ;
    :syntax "TONGG_WW(?variable)" ;
    :constraint "Requires NHOMM_THEO_YY, works only with numeric types" .

:HamTRUU_WJNGG_BINH_PP a owl:Class ;
    rdfs:subClassOf :HamTongHop ;
    rdfs:label "TRUNGG_BINH_PP (AVG)"@vi ;
    rdfs:comment "Calculates average"@en ;
    :keywords "TRUNGG_BINH_PP, AVG" ;
    :syntax "TRUNGG_BINH_PP(?variable)" ;
    :constraint "Requires NHOMM_THEO_YY, works only with numeric types" .

:HamLONN_NHAT_RR a owl:Class ;
    rdfs:subClassOf :HamTongHop ;
    rdfs:label "LONN_NHAT_RR (MAX)"@vi ;
    rdfs:comment "Finds maximum value"@en ;
    :keywords "LONN_NHAT_RR, MAX" ;
    :syntax "LONN_NHAT_RR(?variable)" .

:HamNHOO_NHAT_QQ a owl:Class ;
    rdfs:subClassOf :HamTongHop ;
    rdfs:label "NHOO_NHAT_QQ (MIN)"@vi ;
    rdfs:comment "Finds minimum value"@en ;
    :keywords "NHOO_NHAT_QQ, MIN" ;
    :syntax "NHOO_NHAT_QQ(?variable)" .

# ============================================
# Solution Modifiers (Bộ Điều Chỉnh)
# ============================================

:BoMenhDe a owl:Class ;
    rdfs:label "Bộ mệnh đề"@vi ;
    rdfs:comment "Solution sequence modifiers"@en .

:MenhDeSAP_XXEP_THEO_KK a owl:Class ;
    rdfs:subClassOf :BoMenhDe ;
    rdfs:label "SAP_XXEP_THEO_KK (ORDER BY)"@vi ;
    rdfs:comment "Orders results by expression"@en ;
    :keywords "SAP_XXEP_THEO_KK, ORDER BY" ;
    :syntax "SAP_XXEP_THEO_KK ?variable" ;
    :example "SAP_XXEP_THEO_KK GIAMM_WW(?tuoi)" .

:MenhDeGIOI_HHAN_RR a owl:Class ;
    rdfs:subClassOf :BoMenhDe ;
    rdfs:label "GIOI_HHAN_RR (LIMIT)"@vi ;
    rdfs:comment "Limits number of results"@en ;
    :keywords "GIOI_HHAN_RR, LIMIT" ;
    :syntax "GIOI_HHAN_RR n" ;
    :example "GIOI_HHAN_RR 10" ;
    :constraint "n must be non-negative integer" .

:MenhDeDICCH_CHUYEN_WW a owl:Class ;
    rdfs:subClassOf :BoMenhDe ;
    rdfs:label "DICCH_CHUYEN_WW (OFFSET)"@vi ;
    rdfs:comment "Skips first n results"@en ;
    :keywords "DICCH_CHUYEN_WW, OFFSET" ;
    :syntax "DICCH_CHUYEN_WW n" ;
    :constraint "n must be non-negative integer" .

# ============================================
# Operators (Toán Tử)
# ============================================

:ToanTu a owl:Class ;
    rdfs:label "Toán tử"@vi ;
    rdfs:comment "Operators for conditions and expressions"@en .

:ToanTuVAA_JJ a owl:Class ;
    rdfs:subClassOf :ToanTu ;
    rdfs:label "VAA_JJ (AND)"@vi ;
    rdfs:comment "Logical AND operator"@en ;
    :keywords "VAA_JJ, AND" ;
    :syntax "condition1 VAA_JJ condition2" .

:ToanTuHOACC_WW a owl:Class ;
    rdfs:subClassOf :ToanTu ;
    rdfs:label "HOACC_WW (OR)"@vi ;
    rdfs:comment "Logical OR operator"@en ;
    :keywords "HOACC_WW, OR" ;
    :syntax "condition1 HOACC_WW condition2" .

:ToanTuKHONGG_RR a owl:Class ;
    rdfs:subClassOf :ToanTu ;
    rdfs:label "KHONGG_RR (NOT)"@vi ;
    rdfs:comment "Logical NOT operator"@en ;
    :keywords "KHONGG_RR, NOT" ;
    :syntax "KHONGG_RR condition" .

# ============================================
# Common Constraints (Ràng Buộc Chung)
# ============================================

# Constraint: NHOMM_THEO_YY required for aggregate functions
:NhomTheoRequired a owl:Class ;
    rdfs:label "NHOMM_THEO_YY required constraint" ;
    rdfs:comment "Aggregate functions DEMM_JJ, TONGG_WW, TRUNGG_BINH_PP require NHOMM_THEO_YY clause" .

# Constraint: COO_ZZ can only be used with NHOMM_THEO_YY
:CoRequiresNhomTheo a owl:Class ;
    rdfs:label "COO_ZZ requires NHOMM_THEO_YY constraint" ;
    rdfs:comment "COO_ZZ (HAVING) can only be used when NHOMM_THEO_YY (GROUP BY) is present" .

# Constraint: Query must have NOII_MA_KK clause
:NoiMaRequired a owl:Class ;
    rdfs:label "NOII_MA_KK required constraint" ;
    rdfs:comment "CHONJ_KW and HOIQQ_YZ queries must have NOII_MA_KK (WHERE) clause" .

# ============================================
# Example Queries (Truy Vấn Mẫu)
# ============================================

:ExampleSimple a :TruyVanCHONJ_KW ;
    rdfs:label "Simple CHONJ_KW query" ;
    :vietnameseQuery """
        CHONJ_KW ?ten
        NOII_MA_KK {
            ?nguoi :coTen ?ten .
        }
    """ ;
    :englishQuery """
        SELECT ?name
        WHERE {
            ?person :hasName ?name .
        }
    """ .

:ExampleFilter a :TruyVanCHONJ_KW ;
    rdfs:label "CHONJ_KW with LOCJ_RR" ;
    :vietnameseQuery """
        CHONJ_KW ?ten ?tuoi
        NOII_MA_KK {
            ?nguoi :coTen ?ten ;
                   :coTuoi ?tuoi .
            LOCJ_RR(?tuoi > 18)
        }
    """ ;
    :englishQuery """
        SELECT ?name ?age
        WHERE {
            ?person :hasName ?name ;
                    :hasAge ?age .
            FILTER(?age > 18)
        }
    """ .

:ExampleAggregate a :TruyVanCHONJ_KW ;
    rdfs:label "CHONJ_KW with aggregation" ;
    :vietnameseQuery """
        CHONJ_KW ?thanh_pho (DEMM_JJ(?nguoi) GOI_LLA_KK ?so_luong)
        NOII_MA_KK {
            ?nguoi :song_tai ?thanh_pho .
        }
        NHOMM_THEO_YY ?thanh_pho
        COO_ZZ (DEMM_JJ(?nguoi) > 5)
        SAP_XXEP_THEO_KK GIAMM_WW(?so_luong)
        GIOI_HHAN_RR 10
    """ ;
    :englishQuery """
        SELECT ?city (COUNT(?person) AS ?count)
        WHERE {
            ?person :livesIn ?city .
        }
        GROUP BY ?city
        HAVING (COUNT(?person) > 5)
        ORDER BY DESC(?count)
        LIMIT 10
    """ .
