    {
      "dsl_class": "TruyVan",
      "label_en": "Query"
    },
    {
      "dsl_class": "TruyVan",
      "description": "Base class for all SPARQL-VI queries"
    },
    {
      "dsl_class": "TruyVanCHONJ_KW",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "TruyVanCHONJ_KW",
      "label_vi": "Truy vấn CHONJ_KW (SELECT)"
    },
    {
      "dsl_class": "TruyVanCHONJ_KW",
      "description": "CHONJ_KW query returns variable bindings. Equivalent to SPARQL SELECT."
    },
    {
      "dsl_class": "TruyVanCHONJ_KW",
      "syntax": "CHONJ_KW ?variable NOII_MA_KK { pattern }"
    },
    {
      "dsl_class": "TruyVanCHONJ_KW",
      "example": "CHONJ_KW ?ten NOII_MA_KK { ?nguoi :coTen ?ten }"
    },
    {
      "dsl_class": "TruyVanXAY_DUNGWJ",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "TruyVanXAY_DUNGWJ",
      "label_vi": "Truy vấn XAY_DUNGWJ (CONSTRUCT)"
    },
    {
      "dsl_class": "TruyVanXAY_DUNGWJ",
      "description": "XAY_DUNGWJ query returns RDF graph. Equivalent to SPARQL CONSTRUCT."
    },
    {
      "dsl_class": "TruyVanXAY_DUNGWJ",
      "syntax": "XAY_DUNGWJ { template } NOII_MA_KK { pattern }"
    },
    {
      "dsl_class": "TruyVanXAY_DUNGWJ",
      "example": "XAY_DUNGWJ { ?x :duocGoi ?ten } NOII_MA_KK { ?x :coTen ?ten }"
    },
    {
      "dsl_class": "TruyVanHOIQQ_YZ",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "TruyVanHOIQQ_YZ",
      "label_vi": "Truy vấn HOIQQ_YZ (ASK)"
    },
    {
      "dsl_class": "TruyVanHOIQQ_YZ",
      "description": "HOIQQ_YZ query returns boolean. Equivalent to SPARQL ASK."
    },
    {
      "dsl_class": "TruyVanHOIQQ_YZ",
      "syntax": "HOIQQ_YZ NOII_MA_KK { pattern }"
    },
    {
      "dsl_class": "TruyVanHOIQQ_YZ",
      "example": "HOIQQ_YZ NOII_MA_KK { ?nguoi :coTuoi ?tuoi . LOCJ_RR(?tuoi > 18) }"
    },
    {
      "dsl_class": "TruyVanMO_TAR_PP",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "TruyVanMO_TAR_PP",
