      "dsl_class": "MenhDeLOCJ_RR",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "MenhDeLOCJ_RR",
      "label_vi": "Mệnh đề LOCJ_RR (FILTER)"
    },
    {
      "dsl_class": "MenhDeLOCJ_RR",
      "description": "LOCJ_RR filters solutions by condition. Equivalent to SPARQL FILTER."
    },
    {
      "dsl_class": "MenhDeLOCJ_RR",
      "syntax": "LOCJ_RR(condition)"
    },
    {
      "dsl_class": "MenhDeLOCJ_RR",
      "example": "LOCJ_RR(?tuoi > 18)"
    },
    {
      "dsl_class": "MenhDeLOCJ_RR",
      "constraint": "Must be used inside NOII_MA_KK clause"
    },
    {
