      "dsl_class": "MenhDeNOII_MA_KK",
      "parent_class": "subClassOf"
    },
    {
      "dsl_class": "MenhDeNOII_MA_KK",
      "label_vi": "Mệnh đề NOII_MA_KK (WHERE)"
    },
    {
      "dsl_class": "MenhDeNOII_MA_KK",
      "description": "NOII_MA_KK clause contains graph patterns. Required for most queries."
    },
    {
      "dsl_class": "MenhDeNOII_MA_KK",
      "constraint": "Required for CHONJ_KW, HOIQQ_YZ queries"
