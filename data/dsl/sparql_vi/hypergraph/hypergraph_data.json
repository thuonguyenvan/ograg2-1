    },
    {
      "dsl_class": "TruyVanMO_TAR_PP",
      "description": "MO_TAR_PP query returns RDF description. Equivalent to SPARQL DESCRIBE."
    },
    {
      "dsl_class": "TruyVanMO_TAR_PP",
      "syntax": "MO_TAR_PP ?resource NOII_MA_KK { pattern }"
